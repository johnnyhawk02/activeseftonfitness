---
import '../styles/global.css';
import NoticeBanner from '../components/NoticeBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.tsx';
import { centers, classIndex, notices } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Active Sefton — Leisure centres, pools and classes in Sefton',
  description = 'Swimming, gyms, fitness classes and sport at six Sefton Council leisure centres: Bootle, Crosby, Dunes Southport, Litherland, Meadows Maghull and Netherton.',
} = Astro.props;

const paletteCentres = centers.map(({ id, name, shortName, town, highlights }) => ({ id, name, shortName, town, highlights }));
const paletteClasses = classIndex();
const noticeId = notices[0]?.id ?? '';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF9F6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&family=Plus+Jakarta+Sans:wght@400..700&display=swap"
    />

    <script is:inline define:vars={{ noticeId }}>
      // Hide a dismissed notice before first paint (no layout shift), and pick the right shortcut label.
      try {
        if (noticeId && localStorage.getItem('as-notice-dismissed') === noticeId)
          document.documentElement.classList.add('notice-dismissed');
      } catch (e) {}
      if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.documentElement.classList.add('non-mac');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
      >Skip to main content</a
    >
    <NoticeBanner />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CommandPalette client:idle centres={paletteCentres} classes={paletteClasses} />

    <script is:inline>
      // Clicks on search triggers before the palette island hydrates are queued, not lost.
      document.addEventListener('click', function (e) {
        var t = e.target.closest && e.target.closest('[data-open-palette]');
        if (!t) return;
        e.preventDefault();
        if (window.__asPaletteReady) window.dispatchEvent(new CustomEvent('as:palette-open'));
        else window.__asPaletteQueued = true;
      });
    </script>
  </body>
</html>
