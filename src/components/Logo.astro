---
// Official Active Sefton wordmark; regenerate the files with `npm run brand`.
interface Props { class?: string }
const { class: className } = Astro.props;
---

<img
  src="/images/brand/wordmark-64.webp"
  srcset="/images/brand/wordmark-64.webp 2x, /images/brand/wordmark-96.webp 3x"
  alt="Active Sefton"
  width="233"
  height="32"
  class:list={['h-7 w-auto sm:h-8', className]}
/>
