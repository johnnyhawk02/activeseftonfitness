---
import { centers, imageSrcSet, formatTime } from '../lib/data';
---

<section id="centres" aria-labelledby="centres-heading" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-20 sm:px-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-semibold text-sage">Our centres</p>
      <h2 id="centres-heading" class="mt-2 text-4xl font-medium text-ink sm:text-5xl">Six places to get moving</h2>
    </div>
    <p class="max-w-md text-muted">One Active Sefton membership works at every centre. Pick the one closest to you, or the one with the pool, pitch or class you want.</p>
  </div>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      centers.map((c) => (
        <li class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-soft transition-shadow hover:shadow-md">
          <div class="relative aspect-[3/2] overflow-hidden bg-neutral-100">
            <img
              src={c.image.replace('.jpg', '-480.webp')}
              srcset={imageSrcSet(c.image)}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
              alt={c.imageAlt}
              width="480"
              height="320"
              loading="lazy"
              decoding="async"
              class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">{c.town}</p>
            <h3 class="mt-1.5 text-2xl font-medium text-ink">
              <a href={`/centres/${c.id}/`} class="hover:text-sage">
                {c.name}
              </a>
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{c.summary}</p>

            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Highlights">
              {c.highlights.map((h) => (
                <li class="rounded-md border border-sage-100 bg-sage-50 px-2 py-1 text-xs font-medium text-sage">{h}</li>
              ))}
            </ul>

            <dl class="mt-5 space-y-1 border-t border-neutral-200 pt-4 text-sm">
              {c.hours.map((h) => (
                <div class="flex justify-between gap-4">
                  <dt class="text-muted">{h.days}</dt>
                  <dd class="font-medium text-ink tabular-nums">
                    {formatTime(h.open)} – {formatTime(h.close)}
                  </dd>
                </div>
              ))}
            </dl>

            <div class="mt-auto flex items-center gap-3 pt-6">
              <a
                href={`/?centre=${c.id}#timetable`}
                data-filter-centre={c.id}
                class="inline-flex flex-1 items-center justify-center rounded-lg bg-sage px-4 py-2.5 text-sm font-semibold text-white hover:bg-sage-hover"
              >
                View schedule<span class="sr-only"> for {c.name}</span>
              </a>
              <a
                href={`/centres/${c.id}/`}
                class="inline-flex items-center justify-center rounded-lg border border-neutral-200 px-4 py-2.5 text-sm font-semibold text-ink hover:border-neutral-300 hover:bg-canvas"
              >
                Details<span class="sr-only"> about {c.name}</span>
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { filterTimetable } from '../lib/shared';

  // On the home page, "View schedule" filters the timetable in place instead of reloading.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-filter-centre]');
    const timetable = document.getElementById('timetable');
    if (!link || !timetable) return;
    e.preventDefault();
    filterTimetable({ centre: link.dataset.filterCentre! });
    timetable.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>
