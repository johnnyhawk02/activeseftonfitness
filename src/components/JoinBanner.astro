---
// Big "Not a member yet?" panel with a Join online button, shown under the menu on the home and App pages.
import { BOOKING_URL, memberships } from '../lib/data';

interface Props {
  /** Line under the heading; "{price}" is replaced by the cheapest monthly price. */
  message?: string;
}

const fromPrice = Math.min(...memberships.plans.map((p) => p.price));
const { message = 'One membership, six centres. Memberships start at £{price} a month.' } = Astro.props;
const text = message.replace('{price}', String(fromPrice));
---

<aside aria-labelledby="join-heading" class="bg-brand text-white">
  <div class="mx-auto grid max-w-6xl items-center gap-6 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:gap-12 md:py-12">
    <div>
      <h2 id="join-heading" class="text-4xl leading-tight font-medium sm:text-5xl">Not a member yet?</h2>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-white/85">
        {text}
      </p>
    </div>
    <div class="flex flex-col items-start gap-3 md:items-center">
      <a
        href="/memberships/"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-10 py-5 text-xl font-semibold text-brand shadow-soft hover:bg-brand-50 sm:w-auto"
        >Join online
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-white underline underline-offset-4 hover:text-white/80"
        >Or book a one-off session<span class="sr-only"> (opens in a new tab)</span></a
      >
    </div>
  </div>
</aside>
