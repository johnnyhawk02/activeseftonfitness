---
// Small floating "Not a member yet?" card with a Join online button, on the home and App pages.
// It slides in at the bottom of the screen; closing it is remembered in this browser.
import { memberships } from '../lib/data';

interface Props {
  /** Line under the heading; "{price}" is replaced by the cheapest monthly price. */
  message?: string;
}

const fromPrice = Math.min(...memberships.plans.map((p) => p.price));
const { message = 'One membership, six centres, from £{price} a month.' } = Astro.props;
const text = message.replace('{price}', String(fromPrice));
---

<aside
  data-join-float
  hidden
  aria-labelledby="join-heading"
  class="join-float fixed inset-x-3 bottom-3 z-30 rounded-2xl bg-brand p-5 pr-12 text-white shadow-[0_16px_40px_-12px_rgba(26,26,26,0.45)] sm:inset-x-auto sm:right-5 sm:bottom-5 sm:w-[22rem]"
  style="margin-bottom: env(safe-area-inset-bottom)"
>
  <button
    type="button"
    data-join-close
    aria-label="Close"
    class="absolute top-3 right-3 grid size-8 place-items-center rounded-full text-white/80 hover:bg-white/15 hover:text-white"
  >
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <h2 id="join-heading" class="text-xl font-medium">Not a member yet?</h2>
  <p class="mt-1 text-sm leading-relaxed text-white/85">{text}</p>
  <a href="/memberships/" class="mt-4 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-50"
    >Join online
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  </a>
</aside>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .join-float:not([hidden]) {
      animation: join-in 300ms ease-out 600ms both;
    }
  }
  @keyframes join-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'as-join-dismissed';
    var card = document.querySelector('[data-join-float]');
    if (!card) return;
    try {
      if (localStorage.getItem(KEY)) return;
    } catch (e) {}
    card.hidden = false;
    card.querySelector('[data-join-close]').addEventListener('click', function () {
      card.hidden = true;
      try {
        localStorage.setItem(KEY, '1');
      } catch (e) {}
    });
  })();
</script>
