---
import Kbd from './Kbd.astro';
import { centers, sessions, imageSrcSet } from '../lib/data';

const pools = 7; // Bootle: main + leisure · Dunes: main + learner + Splash World · Meadows: main + learner
const feature = centers.find((c) => c.id === 'dunes')!;
---

<section class="border-b border-neutral-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-12 pb-14 sm:px-6 md:pt-16 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:pt-20 lg:pb-20">
    <div class="flex flex-col justify-center">
      <p class="mb-5 text-sm font-semibold tracking-wide text-brand">Sefton Council Leisure · Six centres, one membership</p>
      <h1 class="text-[2.6rem] leading-[1.05] font-medium text-ink sm:text-6xl lg:text-[4.1rem]">
        Health and activity for every stage of life in&nbsp;<em class="font-normal text-brand">Sefton.</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Pools, gyms, studios, a marine lake and an athletics track — from Bootle to Southport. Find a session that suits you and book in a couple of taps.
      </p>

      <button
        type="button"
        data-open-palette
        class="group mt-8 flex w-full max-w-xl items-center gap-3 rounded-xl border border-neutral-300 bg-white px-4 py-4 text-left shadow-soft transition-colors hover:border-brand"
      >
        <svg aria-hidden="true" class="size-5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="flex-1 text-base text-muted group-hover:text-ink">Search “Lane Swim”, “Spin”, “Pilates” or a centre…</span>
        <Kbd />
      </button>

      <div class="mt-8">
        <h2 id="choose-centre" class="font-sans text-xs font-semibold tracking-[0.12em] text-muted uppercase">Choose your centre</h2>
        <ul aria-labelledby="choose-centre" class="mt-3 flex flex-wrap gap-2">
          {
            centers.map((c) => (
              <li>
                <a
                  href={`/centres/${c.id}/`}
                  class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3.5 py-2 text-sm font-medium text-ink hover:border-brand hover:text-brand"
                >
                  {c.shortName}
                  {c.town !== c.shortName && <span class="text-muted">· {c.town}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="flex flex-col self-center overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-soft">
      <div class="relative aspect-[4/3] bg-neutral-100 lg:aspect-square">
        <img
          src={feature.image.replace('.jpg', '-960.webp')}
          srcset={`${imageSrcSet(feature.image)}, ${feature.image} 1600w`}
          sizes="(min-width: 1024px) 480px, 100vw"
          alt={feature.imageAlt}
          width="960"
          height="640"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
        <figcaption class="absolute bottom-3 left-3 rounded-md bg-white/90 px-2.5 py-1 text-xs font-medium text-ink backdrop-blur-sm">
          {feature.name}, {feature.town}
        </figcaption>
      </div>
      <dl class="grid grid-cols-3 divide-x divide-neutral-200 border-t border-neutral-200">
        {
          [
            ['Centres', centers.length],
            ['Sessions a week', sessions.length],
            ['Pools', pools],
          ].map(([label, value]) => (
            <div class="flex flex-col-reverse items-center gap-1 px-2 py-4 sm:py-5">
              <dt class="text-xs font-medium whitespace-nowrap text-muted">{label}</dt>
              <dd class="font-serif text-3xl leading-none text-ink tabular-nums sm:text-4xl">{value}</dd>
            </div>
          ))
        }
      </dl>
    </figure>
  </div>
</section>
