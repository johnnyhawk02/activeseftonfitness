---
import Layout from '../layouts/Layout.astro';
import { centers, centerById, memberships, type MembershipPlan } from '../lib/data';

const { benefits, groups, plans, joinUrl, portal, phone, checked, sourceUrl } = memberships;
const tel = `tel:${phone.replace(/\s/g, '')}`;
const fromPrice = Math.min(...plans.filter((p) => p.group === 'adult').map((p) => p.price));
const checkedLabel = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(checked));
// Most memberships include gym, swim and classes at every centre; the group intro says so, cards only note differences.
const STANDARD_INCLUDES = 'Gym, swim and exercise classes';
const centresOf = (p: MembershipPlan) => p.centres.map((id) => centerById[id]).filter(Boolean);
const siteIdsOf = (p: MembershipPlan) => centresOf(p).map((c) => c.bookingSiteId).join(',');
const listNames = (names: string[]) => names.slice(0, -1).join(', ') + ' or ' + names[names.length - 1];
---

<Layout
  title="Memberships — Active Sefton"
  description={`Gym, swim and classes at six Sefton leisure centres from £${fromPrice} a month. Compare Active Sefton memberships, concessions and junior swim, and join online.`}
>
  <header class="border-b border-neutral-200">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-10 pb-14 sm:px-6 lg:grid-cols-[1fr_1fr] lg:gap-14 lg:pt-14">
      <div class="flex flex-col">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <ol class="flex gap-2">
            <li><a href="/" class="hover:text-ink hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">Memberships</li>
          </ol>
        </nav>
        <p class="mt-8 text-sm font-semibold text-brand">Active Fitness membership · from £{fromPrice} a month</p>
        <h1 class="mt-2 text-5xl leading-[1.05] font-medium text-ink sm:text-6xl">One membership. <em class="font-normal text-brand">Six centres.</em></h1>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          Gym, pools and unlimited classes at every Active Sefton centre, from Bootle to Southport — for much less than you might think.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#plans" class="rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white hover:bg-brand-hover">Compare memberships</a>
          <a href="#join-setup" class="rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-ink hover:border-neutral-400">Join online</a>
        </div>
      </div>

      <section aria-labelledby="benefits" class="self-center rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft sm:p-8">
        <h2 id="benefits" class="text-2xl font-medium text-ink">As a member you get</h2>
        <ul class="mt-5 grid gap-x-6 gap-y-2.5 text-sm text-ink sm:grid-cols-2">
          {
            benefits.map((b) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-brand-hover" />
                {b}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </header>

  <div id="plans" class="mx-auto max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <section id="join-setup" aria-labelledby="join-setup-heading" data-join-setup data-memberships-url={portal.membershipsUrl} data-fallback-url={joinUrl} class="mt-14 scroll-mt-24 rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft transition-shadow sm:p-8">
      <h2 id="join-setup-heading" class="text-2xl font-medium text-ink">Joining online?</h2>
      <p class="mt-1.5 text-sm text-muted">
        Pick your home centre here, then on a membership choose how to pay and press <strong class="font-semibold text-ink">Join online</strong>. Our booking portal opens in a new tab with it already chosen, ready to pay.
      </p>
      <div class="mt-5">
        <fieldset>
          <legend class="text-xs font-semibold tracking-[0.12em] text-muted uppercase">Home centre</legend>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {
              centers.map((c) => (
                <label class="cursor-pointer">
                  <input type="radio" name="join-centre" value={c.bookingSiteId} data-name={c.shortName} class="peer sr-only" />
                  <span class="inline-flex rounded-full border border-neutral-200 bg-white px-3.5 py-2 text-sm font-medium text-ink peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:border-brand">
                    {c.shortName}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>
      <p data-join-hint class="mt-4 hidden text-sm font-semibold text-brand-red" role="status">Choose your home centre first.</p>
    </section>
    {
      groups.map((g) => (
        <section aria-labelledby={`group-${g.id}`} class="pt-16">
          <h2 id={`group-${g.id}`} class="text-3xl font-medium text-ink sm:text-4xl">
            {g.title}
          </h2>
          <p class="mt-2 text-muted">{g.intro}</p>
          <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {plans
              .filter((p) => p.group === g.id)
              .map((p) => (
                <li
                  class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-5 shadow-soft"
                  data-monthly-price={p.price}
                  data-annual-price={p.annualPrice}
                  data-joins={JSON.stringify(p.join)}
                >
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-2xl leading-tight font-medium text-ink">
                      {p.name}
                      {p.variant && <span class="block font-sans text-sm font-semibold text-muted">{p.variant}</span>}
                    </h3>
                    {p.ages && <span class="shrink-0 rounded-full bg-neutral-100 px-2.5 py-1 text-xs font-semibold text-ink">{p.ages}</span>}
                  </div>

                  {/* Monthly prices show until the visitor picks Yearly; the script swaps the two blocks. */}
                  <div data-price="monthly">
                    <p class="mt-4 flex items-baseline gap-1.5">
                      <span class="font-serif text-4xl leading-none text-ink tabular-nums">£{p.price}</span>
                      <span class="text-sm text-muted">a month</span>
                    </p>
                    <p class="mt-1.5 text-sm text-muted">
                      {p.minimumMonths}-month minimum{p.annualPrice && <> · or <span class="font-semibold text-ink">£{p.annualPrice}</span> a year</>}
                    </p>
                  </div>
                  {p.annualPrice && (
                    <div data-price="annual" hidden>
                      <p class="mt-4 flex items-baseline gap-1.5">
                        <span class="font-serif text-4xl leading-none text-ink tabular-nums">£{p.annualPrice}</span>
                        <span class="text-sm text-muted">a year</span>
                      </p>
                      <p class="mt-1.5 text-sm text-muted">
                        Paid upfront · or <span class="font-semibold text-ink">£{p.price}</span> a month
                      </p>
                    </div>
                  )}
                  {p.join
                    .filter((j) => j.annualFee)
                    .map((j) => (
                      <p class="mt-1 text-sm text-muted">
                        <span class="font-semibold text-ink">{j.label}</span> adds a £{j.annualFee} annual fee.
                      </p>
                    ))}

                  {p.includes !== STANDARD_INCLUDES && (
                    <p class="mt-3 text-sm font-semibold text-ink">
                      {p.includes}
                      {p.centres.length < centers.length && (
                        <span class="font-normal text-muted">, at {listNames(centresOf(p).map((c) => c.shortName)).replace(' or ', ' and ')}</span>
                      )}
                    </p>
                  )}
                  {p.eligibility && (
                    <p class="mt-3 text-xs leading-relaxed text-muted">
                      <span class="font-semibold text-ink">Who qualifies:</span> {p.eligibility}
                    </p>
                  )}

                  <div class="mt-auto pt-5">
                    <fieldset data-pay>
                      <legend class="mb-1.5 text-xs font-semibold text-ink">{p.join.length > 1 ? '1. How to pay' : 'How to pay'}</legend>
                      <div class:list={['grid gap-1 rounded-lg bg-neutral-100 p-1', p.annualPrice ? 'grid-cols-3' : 'grid-cols-2']}>
                        {portal.paymentOptions.filter((o) => o.key !== 'Annual' || p.annualPrice).map((o) => (
                          <label class="cursor-pointer">
                            <input type="radio" name={`pay-${p.id}`} value={o.key} class="peer sr-only" />
                            <span class="flex h-full items-center justify-center rounded-md px-1 py-1.5 text-center text-xs leading-tight font-semibold text-muted peer-checked:bg-white peer-checked:text-ink peer-checked:shadow-soft peer-focus-visible:outline-2 peer-focus-visible:outline-brand hover:text-ink">
                              {o.label}
                            </span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                    {p.join.length > 1 && (
                      <fieldset data-type class="mt-3">
                        <legend class="mb-1.5 text-xs font-semibold text-ink">2. {p.name.replace(/s$/, '')} type</legend>
                        <div class="grid grid-cols-3 gap-1 rounded-lg bg-neutral-100 p-1">
                          {p.join.map((j, i) => (
                            <label class="cursor-pointer">
                              <input type="radio" name={`type-${p.id}`} value={i} class="peer sr-only" />
                              <span class="flex h-full items-center justify-center rounded-md px-1 py-1.5 text-center text-xs leading-tight font-semibold text-muted peer-checked:bg-white peer-checked:text-ink peer-checked:shadow-soft peer-focus-visible:outline-2 peer-focus-visible:outline-brand hover:text-ink">
                                {j.label}
                              </span>
                            </label>
                          ))}
                        </div>
                      </fieldset>
                    )}
                    {/* Shown until the choices are made; turns red if Join is pressed too early. */}
                    <p data-pay-hint class="mt-2 text-xs text-muted" role="status">
                      {p.join.length > 1 ? 'Choose how to pay and your concession type, then Join online appears.' : 'Choose how to pay to see what you’ll pay today and join.'}
                    </p>
                    <div data-today hidden aria-live="polite" class="mt-3 rounded-lg bg-brand-50 px-3 py-2.5 text-sm text-ink"></div>
                    {/* Plans with several types (concessions) only show Join once a type and a way to pay are picked. */}
                    <a
                      href={joinUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-join
                      data-multi={p.join.length > 1 ? '' : undefined}
                      data-sites={siteIdsOf(p)}
                      class="mt-3 flex justify-center rounded-lg bg-brand px-3 py-3 text-center text-sm font-semibold text-white hover:bg-brand-hover aria-disabled:cursor-not-allowed aria-disabled:opacity-50"
                    >
                      Join online<span class="sr-only"> — {p.name} {p.variant ?? ''} (opens in a new tab)</span>
                    </a>
                    {p.centres.length < centers.length && (
                      <p class="mt-2 hidden text-center text-xs font-semibold text-brand-red" data-join-note>
                        Home centre must be {listNames(centresOf(p).map((c) => c.shortName))}
                      </p>
                    )}
                  </div>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section aria-labelledby="how-to-join" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <p class="text-sm font-semibold text-brand">Getting started</p>
    <h2 id="how-to-join" class="mt-2 text-4xl font-medium text-ink">How to join</h2>
    <ol class="mt-8 grid gap-5 md:grid-cols-3">
      <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <span class="font-serif text-3xl text-brand">1</span>
        <h3 class="mt-2 text-xl font-medium text-ink">Online</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Pick your home centre above, choose how to pay on a membership (monthly Direct Debit on the 1st or 17th, or yearly), then press Join online. You’ll land on it in our booking portal, ready to pay.
        </p>
        <a href="#join-setup" class="mt-4 inline-block text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-hover">Choose a centre</a>
      </li>
      <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <span class="font-serif text-3xl text-brand">2</span>
        <h3 class="mt-2 text-xl font-medium text-ink">At any centre</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Ask at reception in any of the six centres. For a concession or corporate membership you’ll need to show you qualify.
        </p>
        <a href="/#centres" class="mt-4 inline-block text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-hover">Find a centre</a>
      </li>
      <li class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <span class="font-serif text-3xl text-brand">3</span>
        <h3 class="mt-2 text-xl font-medium text-ink">Not sure which?</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Call us to talk through which membership suits you, or to check whether you qualify for a concession.
        </p>
        <a href={tel} class="mt-4 inline-block text-sm font-semibold text-brand underline underline-offset-4 hover:text-brand-hover">{phone}</a>
      </li>
    </ol>
    <p class="mt-8 text-xs text-muted">
      Prices from <a href={sourceUrl} class="underline underline-offset-2 hover:text-ink">activeseftonfitness.co.uk</a>, checked {checkedLabel}. Yearly prices are paid upfront.
    </p>
  </section>
</Layout>

<script>
  import { addDays, londonDateKey, membershipJoinUrl, monthlyJoinCost, type MembershipJoin } from '../lib/shared';

  const gbp = (n: number) => `£${Number.isInteger(n) ? n : n.toFixed(2)}`;
  const shortDate = (iso: string, withMonth = true) =>
    new Intl.DateTimeFormat('en-GB', { day: 'numeric', ...(withMonth && { month: 'short' }), timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));
  const monthName = (iso: string) => new Intl.DateTimeFormat('en-GB', { month: 'long', timeZone: 'UTC' }).format(new Date(`${iso}T12:00:00Z`));

  type Join = MembershipJoin;
  const joinsOf = (card: HTMLElement): Join[] => JSON.parse(card.dataset.joins || '[]');
  /** The membership type picked on the card: the only one, or the checked one when there are several. */
  function joinOf(card: HTMLElement) {
    const joins = joinsOf(card);
    if (joins.length === 1) return joins[0];
    const i = card.querySelector<HTMLInputElement>('[data-type] input:checked')?.value;
    return i === undefined ? undefined : joins[Number(i)];
  }

  /** "Pay £47.10 today …" for a card, type and payment choice, using today's date in London. */
  function todayText(card: HTMLElement, payment: string, join: Join) {
    const monthly = Number(card.dataset.monthlyPrice);
    const annual = join.annualPrice ?? Number(card.dataset.annualPrice);
    const fee = join.annualFee ?? 0;
    if (payment === 'Annual') return `<strong>Pay ${gbp(annual)} today</strong> for 12 months${fee ? `, including the ${gbp(fee)} ${join.label} annual fee` : ''}.`;
    const day = payment === 'DD17th' ? 17 : 1;
    const c = monthlyJoinCost(monthly, day, fee);
    const today = londonDateKey();
    const collection = addDays(c.lastProRataDay, 1);
    const sameMonth = today.slice(0, 7) === c.lastProRataDay.slice(0, 7);
    // The part-month, then (when the first collection is under 17 days away) the first full month, both paid today.
    const dates = `${shortDate(today, !sameMonth)}–${shortDate(c.lastProRataDay)}`;
    const firstMonth =
      day === 1 ? `${gbp(monthly)} for ${monthName(collection)}` : `${gbp(monthly)} for ${shortDate(collection)}–${shortDate(addDays(c.firstDebit, -1))}`;
    const feePart = fee ? ` + ${gbp(fee)} ${join.label} annual fee` : '';
    const breakdown = !c.firstMonthUpfront
      ? fee
        ? ` (${gbp(c.proRata)} for ${dates}${feePart})`
        : ` for ${dates}`
      : c.days
        ? ` (${gbp(c.proRata)} for ${dates} + ${firstMonth}${feePart})`
        : ` (${firstMonth}${feePart})`;
    return `<strong>Pay ${gbp(c.total)} today</strong>${breakdown}. Then ${gbp(monthly)} on the ${day === 1 ? '1st' : '17th'} of each month from ${shortDate(c.firstDebit)}.`;
  }


  // Join buttons fall back to the portal's centre picker (no JS, or no centre chosen yet). Once a home
  // centre is picked they deep-link to that membership, unless it isn't sold there (swim at Crosby).
  const STORE = 'as-join-centre';
  const setup = document.querySelector<HTMLElement>('[data-join-setup]')!;
  const { membershipsUrl = '', fallbackUrl = '' } = setup.dataset;
  const hint = setup.querySelector<HTMLElement>('[data-join-hint]')!;
  const radios = (name: string) => [...setup.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`)];
  const picked = (name: string) => radios(name).find((r) => r.checked);

  try {
    const saved = localStorage.getItem(STORE);
    const r = radios('join-centre').find((x) => x.value === saved);
    if (r) r.checked = true;
  } catch {}

  const paymentOf = (card: Element) => card.querySelector<HTMLInputElement>('[data-pay] input:checked')?.value;

  function update() {
    const centre = picked('join-centre');
    if (centre) hint.classList.add('hidden');
    for (const card of document.querySelectorAll<HTMLElement>('li:has([data-pay])')) {
      const payment = paymentOf(card);
      const yearly = payment === 'Annual';
      card.querySelector<HTMLElement>('[data-price="monthly"]')!.hidden = yearly;
      const annual = card.querySelector<HTMLElement>('[data-price="annual"]');
      if (annual) annual.hidden = !yearly;
      const join = joinOf(card);
      card.querySelector('[data-pay-hint]')?.classList.toggle('hidden', !!(payment && join));
      const today = card.querySelector<HTMLElement>('[data-today]');
      if (today) {
        today.hidden = !(payment && join);
        if (payment && join) today.innerHTML = todayText(card, payment, join);
      }
    }
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-join]')) {
      const card = a.closest('li')!;
      const payment = paymentOf(card);
      const join = joinOf(card);
      // A concessions card has no Join button at all until the type and the way to pay are both picked.
      if (a.hasAttribute('data-multi')) a.hidden = !(payment && join);
      const sites = (a.dataset.sites ?? '').split(',');
      const ok = !centre || sites.includes(centre.value);
      const note = a.closest('li')?.querySelector<HTMLElement>('[data-join-note]');
      note?.classList.toggle('hidden', ok);
      // Greyed out until a way to pay is picked, and for good when the centre doesn't sell it.
      a.dataset.blocked = !ok ? 'centre' : !(payment && join) ? 'payment' : '';
      if (ok && payment && join) a.removeAttribute('aria-disabled');
      else a.setAttribute('aria-disabled', 'true');
      if (centre && ok && payment && join) {
        a.href = membershipJoinUrl(membershipsUrl, centre.value, join, payment);
      } else {
        a.href = fallbackUrl;
      }
    }
  }

  document.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'join-centre') {
      try {
        localStorage.setItem(STORE, t.value);
      } catch {}
    }
    update();
  });

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[data-join]');
    if (!a) return;
    if (a.dataset.blocked === 'payment') {
      e.preventDefault();
      const card = a.closest('li')!;
      card.querySelector('[data-pay-hint]')?.classList.add('font-semibold', '!text-brand-red');
      card.querySelector<HTMLInputElement>('[data-pay] input')?.focus();
      return;
    }
    if (a.hasAttribute('aria-disabled')) return e.preventDefault();
    if (picked('join-centre')) return;
    e.preventDefault();
    hint.classList.remove('hidden');
    setup.scrollIntoView({ block: 'center' });
    radios('join-centre')[0]?.focus({ preventScroll: true });
  });

  update();
</script>
