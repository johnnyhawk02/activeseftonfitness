---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import JoinBanner from '../components/JoinBanner.astro';
import CenterGrid from '../components/CenterGrid.astro';
import { sessions } from '../lib/data';
---

<Layout>
  <JoinBanner />
  <Hero />
  <CenterGrid />

  <section aria-labelledby="timetable-cta" class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <a
      href="/timetable/"
      class="group flex flex-col gap-4 rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft hover:border-brand sm:flex-row sm:items-center sm:justify-between sm:p-8"
    >
      <span>
        <span class="block text-sm font-semibold text-brand">The next 8 days</span>
        <span id="timetable-cta" class="mt-1 block font-serif text-3xl font-medium text-ink sm:text-4xl">Classes &amp; sessions timetable</span>
        <span class="mt-2 block text-muted">{sessions.length} swims, classes and gym sessions a week across all six centres.</span>
      </span>
      <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white group-hover:bg-brand-hover sm:self-center"
        >See the timetable
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </span>
    </a>
  </section>
</Layout>
