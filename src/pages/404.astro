---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — Active Sefton">
  <section class="mx-auto max-w-2xl px-4 py-28 text-center sm:px-6">
    <p class="text-sm font-semibold text-brand">404</p>
    <h1 class="mt-3 text-5xl font-medium text-ink">We can’t find that page</h1>
    <p class="mt-5 text-lg text-muted">It may have moved when we refreshed the site. Try searching, or head back to the home page.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white hover:bg-brand-hover">Home page</a>
      <button type="button" data-open-palette class="rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-ink">Search</button>
    </div>
  </section>
</Layout>
