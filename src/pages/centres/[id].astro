---
import Layout from '../../layouts/Layout.astro';
import Timetable from '../../components/Timetable.tsx';
import { BOOKING_URL, centers, sessions, imageSrcSet, formatTime, type Center } from '../../lib/data';

export function getStaticPaths() {
  return centers.map((c) => ({ params: { id: c.id }, props: { centre: c } }));
}

const { centre } = Astro.props as { centre: Center };
const centreSessions = sessions.filter((s) => s.centerId === centre.id);
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${centre.name}, ${centre.address}`)}`;
const others = centers.filter((c) => c.id !== centre.id);
---

<Layout title={`${centre.name} — Active Sefton`} description={centre.summary}>
  <article>
    <header class="border-b border-neutral-200">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-10 pb-14 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:pt-14">
        <div class="flex flex-col">
          <nav aria-label="Breadcrumb" class="text-sm text-muted">
            <ol class="flex gap-2">
              <li><a href="/" class="hover:text-ink hover:underline">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="/#centres" class="hover:text-ink hover:underline">Centres</a></li>
            </ol>
          </nav>
          <p class="mt-8 text-xs font-semibold tracking-[0.12em] text-muted uppercase">{centre.town}</p>
          <h1 class="mt-2 text-5xl leading-[1.05] font-medium text-ink sm:text-6xl">{centre.name}</h1>
          <p class="mt-6 text-lg leading-relaxed text-muted">{centre.description}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#timetable" class="rounded-lg bg-sage px-5 py-3 text-sm font-semibold text-white hover:bg-sage-hover">See this week’s sessions</a>
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-neutral-300 bg-white px-5 py-3 text-sm font-semibold text-ink hover:border-neutral-400"
              >Book online<span class="sr-only"> (opens in a new tab)</span></a
            >
          </div>
        </div>
        <div class="aspect-[3/2] overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-100 shadow-soft">
          <img
            src={centre.image.replace('.jpg', '-960.webp')}
            srcset={`${imageSrcSet(centre.image)}, ${centre.image} 1600w`}
            sizes="(min-width: 1024px) 560px, 100vw"
            alt={centre.imageAlt}
            width="960"
            height="640"
            fetchpriority="high"
            class="size-full object-cover"
          />
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-6 px-4 pt-14 sm:px-6 md:grid-cols-3">
      <section aria-labelledby="hours" class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <h2 id="hours" class="text-2xl font-medium text-ink">Opening times</h2>
        <dl class="mt-4 space-y-2 text-sm">
          {
            centre.hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-neutral-100 pb-2 last:border-0">
                <dt class="text-muted">{h.days}</dt>
                <dd class="font-semibold text-ink tabular-nums">
                  {formatTime(h.open)} – {formatTime(h.close)}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm leading-relaxed text-muted">{centre.hoursNote}</p>
      </section>

      <section aria-labelledby="facilities" class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <h2 id="facilities" class="text-2xl font-medium text-ink">Facilities</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink">
          {
            centre.amenities.map((a) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-sage-hover" />
                {a}
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="visit" class="rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft">
        <h2 id="visit" class="text-2xl font-medium text-ink">Find us</h2>
        <address class="mt-4 text-sm leading-relaxed text-ink not-italic">{centre.address}</address>
        <p class="mt-3 text-sm">
          <a href={`tel:${centre.phone.replace(/\s/g, '')}`} class="font-semibold text-sage underline underline-offset-4 hover:text-sage-hover">
            {centre.phone}
          </a>
        </p>
        <p class="mt-3 text-sm">
          <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-sage underline underline-offset-4 hover:text-sage-hover"
            >Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span></a
          >
        </p>
      </section>
    </div>

    <section id="timetable" data-locked="true" aria-labelledby="timetable-heading" class="mx-auto max-w-6xl scroll-mt-24 px-4 pt-20 sm:px-6">
      <p class="text-sm font-semibold text-sage">This week at {centre.shortName}</p>
      <h2 id="timetable-heading" class="mt-2 text-4xl font-medium text-ink">Classes &amp; sessions</h2>
      {centre.timetableNote && <p class="mt-3 max-w-2xl text-muted">{centre.timetableNote}</p>}
      <div class="mt-8">
        <Timetable client:idle sessions={centreSessions} centres={[{ id: centre.id, name: centre.name, shortName: centre.shortName, bookingSiteId: centre.bookingSiteId }]} lockedCentre={centre.id} />
      </div>
    </section>

    <nav aria-labelledby="other-centres" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
      <h2 id="other-centres" class="text-2xl font-medium text-ink">Other Active Sefton centres</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {
          others.map((c) => (
            <li>
              <a href={`/centres/${c.id}/`} class="block rounded-xl border border-neutral-200 bg-white p-4 hover:border-sage">
                <span class="block font-semibold text-ink">{c.shortName}</span>
                <span class="block text-sm text-muted">{c.town}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</Layout>
