---
import Layout from '../layouts/Layout.astro';
import { appInfo } from '../lib/data';

const { stores, forgottenPasswordUrl, accountNeeds, guides, sourceUrl, checked } = appInfo;
const checkedLabel = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(checked));
const storeLinks = [
  { href: stores.appStore, small: 'Download on the', big: 'App Store', label: 'Get the Active Sefton app on the App Store' },
  { href: stores.googlePlay, small: 'Get it on', big: 'Google Play', label: 'Get the Active Sefton app on Google Play' },
];
---

<Layout
  title="The Active Sefton app — how to use it"
  description="Get the Active Sefton app for iPhone or Android, and watch short guides to logging in, booking and cancelling classes, and booking for a group."
>
  <header class="border-b border-neutral-200">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-10 pb-14 sm:px-6 lg:grid-cols-[1fr_1fr] lg:gap-14 lg:pt-14">
      <div class="flex flex-col">
        <nav aria-label="Breadcrumb" class="text-sm text-muted">
          <ol class="flex gap-2">
            <li><a href="/" class="hover:text-ink hover:underline">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">App</li>
          </ol>
        </nav>
        <p class="mt-8 text-sm font-semibold text-brand">Customer app · iPhone and Android</p>
        <h1 class="mt-2 text-5xl leading-[1.05] font-medium text-ink sm:text-6xl">Book in your <em class="font-normal text-brand">pocket.</em></h1>
        <p class="mt-6 text-lg leading-relaxed text-muted">
          The Active Sefton app lets you book classes, swims and activities, cancel when plans change, and book for the whole family. Three short videos below show you how.
        </p>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            storeLinks.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${s.label} (opens in a new tab)`}
                  class="flex min-w-44 flex-col rounded-xl bg-ink px-5 py-2.5 text-white hover:bg-neutral-800"
                >
                  <span class="text-xs leading-tight text-white/75">{s.small}</span>
                  <span class="text-lg leading-tight font-semibold">{s.big}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <section aria-labelledby="account" class="self-center rounded-2xl border border-neutral-200 bg-white p-6 shadow-soft sm:p-8">
        <h2 id="account" class="text-2xl font-medium text-ink">Logging in</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink">You log in with your Active Sefton account. To have one, you need:</p>
        <ul class="mt-3 space-y-2 text-sm text-ink">
          {
            accountNeeds.map((n) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-brand-hover" />
                {n}
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm leading-relaxed text-muted">Have an account but never set a password, or forgotten it? Set a new one with the email address we have for you.</p>
        <a
          href={forgottenPasswordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm font-semibold text-ink hover:border-brand hover:text-brand"
          >Set or reset your password<span class="sr-only"> (opens in a new tab)</span></a
        >
        <p class="mt-4 text-sm text-muted">
          No account yet? <a href="/memberships/" class="font-semibold text-brand underline underline-offset-4 hover:text-brand-hover">See memberships</a>
        </p>
      </section>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="sr-only">How-to videos</h2>
    {
      guides.map((g, i) => (
        <section
          aria-labelledby={`guide-${g.id}`}
          class:list={['grid items-center gap-8 md:grid-cols-[minmax(0,320px)_1fr] md:gap-16', i === 0 ? 'mt-14' : 'mt-14 border-t border-neutral-200 pt-14']}
        >
          {/*
            Phone mock-up. The recordings (406×720) have blue bands either side of the app; the screen is a
            9:19 window with object-cover, which crops the bands away, and rounded corners mask the edges.
          */}
          <div class="relative mx-auto w-full max-w-[300px] md:max-w-none">
            <span aria-hidden="true" class="absolute top-24 -left-[3px] h-10 w-[3px] rounded-l bg-neutral-700"></span>
            <span aria-hidden="true" class="absolute top-36 -left-[3px] h-14 w-[3px] rounded-l bg-neutral-700"></span>
            <span aria-hidden="true" class="absolute top-32 -right-[3px] h-20 w-[3px] rounded-r bg-neutral-700"></span>
            <div class="rounded-[3rem] bg-ink p-3 shadow-[0_24px_48px_-16px_rgba(26,26,26,0.35)] ring-1 ring-neutral-700/60">
              <div class="relative overflow-hidden rounded-[2.25rem] bg-black">
                <div aria-hidden="true" class="flex h-9 items-center justify-center">
                  <span class="h-[18px] w-20 rounded-full bg-neutral-900 ring-1 ring-neutral-800"></span>
                </div>
                <video
                  controls
                  preload="metadata"
                  playsinline
                  poster={g.poster}
                  width="406"
                  height="720"
                  class="block aspect-[9/19] w-full object-cover"
                  aria-labelledby={`guide-${g.id}`}
                >
                  <source src={g.video} type="video/mp4" />
                  <a href={g.video}>Download the video</a>
                </video>
                <div aria-hidden="true" class="flex h-7 items-center justify-center">
                  <span class="h-1 w-24 rounded-full bg-neutral-600"></span>
                </div>
              </div>
            </div>
          </div>
          <div>
            <p class="font-serif text-3xl text-brand">{i + 1}</p>
            <h3 id={`guide-${g.id}`} class="mt-1 text-3xl font-medium text-ink">
              {g.title}
            </h3>
            <ul class="mt-5 space-y-3 text-ink">
              {g.points.map((p) => (
                <li class="flex gap-3 leading-relaxed">
                  <span aria-hidden="true" class="mt-[0.6rem] size-1.5 shrink-0 rounded-full bg-brand-hover" />
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <p class="mt-16 text-xs text-muted">
      Guides and videos from <a href={sourceUrl} class="underline underline-offset-2 hover:text-ink">activeseftonfitness.co.uk</a>, checked {checkedLabel}.
    </p>
  </div>
</Layout>
